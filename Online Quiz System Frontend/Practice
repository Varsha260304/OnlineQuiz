import java.util.*;
public class Main{
    public static void pro(int arr[],int product[],int n){
        int prefix[]=new int[n];
        prefix[0]=1;
        for(int i=1;i<n;i++){
            prefix[i]=prefix[i-1]*arr[i-1];
        }
        int suffixproduct=1;
        for(int i=n-1;i>=0;i--){
            product[i]=suffixproduct*prefix[i];
            suffixproduct*=arr[i];
        }
    }
    public static void main(String[] args){
        int arr[]={1,3,2,1};
        int n=arr.length;
        int product[]=new int[n];
        pro(arr,product,n);
        System.out.println("Product of array except its index:");
        for(int i=0;i<n;i++){
            System.out.println(product[i]+" ");
        }
        System.out.println();
    }
}